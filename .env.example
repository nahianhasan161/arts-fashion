NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Object storage (Tigris) ---
# Product images are stored in Tigris, an S3-compatible object store. Tigris is
# used instead of Supabase Storage; Supabase remains the database and the auth
# provider.
#
# Credentials come from the Tigris dashboard under Access Keys. The access key
# id looks like "tid_..." and the endpoint is the account's global host.
TIGRIS_STORAGE_ENDPOINT=https://t3.storage.dev
TIGRIS_STORAGE_ACCESS_KEY_ID=
TIGRIS_STORAGE_SECRET_ACCESS_KEY=

# Tigris shares one global namespace across all accounts, so a bucket name that
# reads as obvious, such as "product-images", is often already taken by another
# account and cannot be created. Pick a name that is unlikely to collide.
TIGRIS_STORAGE_BUCKET=artsfashion-media

# How objects are served to browsers.
#   false - images are streamed through /api/media/<path> using signed
#           requests. Works as soon as the keys above are present, with no
#           account configuration. Use this until a payment method is verified.
#   true  - images are served directly by Tigris at
#           https://<endpoint>/<bucket>/<path>. No app bandwidth, CDN-cacheable,
#           and the correct setting for production.
#           Tigris refuses to make a bucket public until a payment method is
#           verified on the account, and answers PaymentVerificationRequired
#           until then, which leaves storefront images broken. Verify payment
#           first, then set this to true and redeploy.
TIGRIS_STORAGE_PUBLIC=false
